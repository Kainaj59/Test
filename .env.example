# Clé API Claude (Anthropic) — nécessaire pour l'agent Sofia (qualification de leads).
# Obtenue sur https://console.anthropic.com/
# Copie ce fichier en .env.local et renseigne ta clé :
#   cp .env.example .env.local
ANTHROPIC_API_KEY=

# URL publique du site (utilisée pour le SEO : Open Graph, robots, sitemap).
# En production, mets l'URL réelle (ex. https://nexora.exemple.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
